# Настройки ESP-IDF по умолчанию для проекта telescope_mount.
#
# 0004: сохранение RF-калибровки в NVS выключено, чтобы переключение точки
# доступа не приводило к записи в flash (правило проекта: запись в flash
# запрещена во время движения). Цена — полная RF-калибровка при
# RF-инициализации и дополнительная задержка, которая измеряется на стенде.
#
# Файл применяется при генерации sdkconfig. При существующем sdkconfig
# значение нужно внести через `idf.py menuconfig`.
CONFIG_ESP_PHY_CALIBRATION_AND_DATA_STORAGE=n

# Размер стека задачи main зафиксирован здесь, а не только в локальном
# sdkconfig: sdkconfig создаётся локально и не отслеживается, поэтому без
# этой строки исправление переполнения стека терялось бы на чистом клоне.
# Значение 8192 подтверждено запуском устройства; уменьшение до 4096
# допускается только после измерения минимального остатка стека.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
