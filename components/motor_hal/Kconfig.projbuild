menu "Telescope mount motor"

    config MOTOR_AXIS_TASK_STACK
        int "Axis task stack size (bytes)"
        default 4096

    config MOTOR_AXIS_TASK_PRIORITY
        int "Axis task priority"
        default 10

    config MOTOR_AXIS_TASK_CORE
        int "Axis task core"
        range 0 1
        default 1

    config MOTOR_CMD_QUEUE_LEN
        int "Command queue length"
        default 8

    config MOTOR_MIN_STEP_INTERVAL_US
        int "Minimum interval between phase switches (us)"
        default 600

    config MOTOR_STEP_TIMER_INTR_PRIORITY
        int "GPTimer interrupt priority"
        range 1 3
        default 3

    config MOTOR_EVENT_WATCHDOG_US
        int "Notification watchdog margin (us)"
        default 5000

    config MOTOR_CMD_BUDGET_PER_ITERATION
        int "Commands processed per wakeup"
        default 8

endmenu
